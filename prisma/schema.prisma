generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  SELLER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum SellerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  REJECTED
  ARCHIVED
}

enum ShipmentStatus {
  READY_TO_SHIP
  PACKED
  SHIPPED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  DELIVERY_FAILED
  RETURN_TO_ORIGIN
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum NotificationType {
  ORDER_PLACED
  ORDER_CONFIRMED
  ORDER_SHIPPED
  ORDER_DELIVERED
  ORDER_CANCELLED
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  RETURN_APPROVED
  RETURN_REJECTED
  REFUND_COMPLETED
  NEW_ORDER_RECEIVED
  ORDER_CANCELLED_SELLER
  NEW_RETURN_REQUEST
  RETURN_REFUND_COMPLETED
  PAYMENT_FLAGGED_FOR_REVIEW
  RETURN_ESCALATED
  REFUND_FAILED
}

model User {
  id           String     @id @default(cuid())
  name         String?
  email        String     @unique
  passwordHash String
  role         UserRole   @default(CUSTOMER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  sellerProfile            SellerProfile?
  sellerStatusActions      SellerStatusHistory[]   @relation("SellerStatusHistoryAdmin")
  productModerationActions ProductStatusHistory[]  @relation("ProductStatusHistoryAdmin")
  customerStatusHistory    CustomerStatusHistory[] @relation("CustomerStatusHistoryCustomer")
  customerStatusActions    CustomerStatusHistory[] @relation("CustomerStatusHistoryAdmin")
  refreshTokens            RefreshToken[]
  orders                   Order[]
  cart                     Cart?
  wishlistItems            WishlistItem[]
  addresses                Address[]
  payments                 Payment[]
  returnRequests           ReturnRequest[]
  notifications            Notification[]

  @@map("users")
}

model SellerProfile {
  id          String       @id @default(cuid())
  userId      String       @unique
  shopName    String       @unique
  description String?
  status      SellerStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user          User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  products      Product[]
  sellerOrders  SellerOrder[]
  statusHistory SellerStatusHistory[]

  @@index([status])
  @@map("seller_profiles")
}

model OrderItem {
  id            String @id @default(cuid())
  orderId       String
  sellerOrderId String
  variantId     String

  productName       String
  variantName       String?
  variantAttributes Json?
  sku               String
  unitPrice         Decimal @db.Decimal(12, 2)
  quantity          Int
  subtotal          Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  order       Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  sellerOrder SellerOrder    @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  returnItems ReturnItem[]

  @@index([orderId])
  @@index([sellerOrderId])
  @@index([variantId])
  @@map("order_items")
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?
  parentId    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@index([parentId])
  @@index([isActive])
  @@map("categories")
}

model Product {
  id          String        @id @default(cuid())
  sellerId    String
  categoryId  String
  name        String
  slug        String        @unique
  description String?
  brand       String?
  status      ProductStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  seller        SellerProfile          @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  category      Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants      ProductVariant[]
  images        ProductImage[]
  wishlistItems WishlistItem[]
  statusHistory ProductStatusHistory[]

  @@index([sellerId, status])
  @@index([categoryId, status])
  @@index([name])
  @@index([createdAt])
  @@map("products")
}

model ProductVariant {
  id             String   @id @default(cuid())
  productId      String
  name           String?
  sku            String   @unique
  attributes     Json?
  price          Decimal  @db.Decimal(12, 2)
  compareAtPrice Decimal? @db.Decimal(12, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product    Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  inventory  Inventory?
  orderItems OrderItem[]
  cartItems  CartItem[]

  @@index([productId, isActive])
  @@map("product_variants")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  altText   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId, sortOrder])
  @@map("product_images")
}

model Inventory {
  id                String   @id @default(cuid())
  variantId         String   @unique
  quantityAvailable Int      @default(0)
  quantityReserved  Int      @default(0)
  updatedAt         DateTime @updatedAt

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@map("inventory")
}

model RefreshToken {
  id           String    @id @default(cuid())
  tokenHash    String    @unique
  userId       String
  familyId     String
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model Order {
  id             String      @id @default(cuid())
  orderNumber    String      @unique
  userId         String
  idempotencyKey String?
  status         OrderStatus @default(PENDING_PAYMENT)

  totalAmount Decimal @db.Decimal(12, 2)
  currency    String  @default("INR")

  // Delivery address snapshot
  deliveryName         String
  deliveryPhone        String
  deliveryAddressLine1 String
  deliveryAddressLine2 String?
  deliveryCity         String
  deliveryState        String
  deliveryPostalCode   String
  deliveryCountry      String  @default("India")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  sellerOrders         SellerOrder[]
  orderItems           OrderItem[]
  orderStatusHistories OrderStatusHistory[]
  payments             Payment[]
  returnRequests       ReturnRequest[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status])
  @@map("orders")
}

model SellerOrder {
  id       String      @id @default(cuid())
  orderId  String
  sellerId String
  status   OrderStatus @default(PENDING_PAYMENT)

  totalAmount Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order          Order                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  seller         SellerProfile        @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  items          OrderItem[]
  shipment       Shipment?
  statusHistory  OrderStatusHistory[]
  returnRequests ReturnRequest[]

  @@unique([orderId, sellerId])
  @@index([sellerId, status])
  @@map("seller_orders")
}

model Shipment {
  id             String   @id @default(cuid())
  sellerOrderId  String   @unique
  carrierName    String
  trackingNumber String
  trackingUrl    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  status              ShipmentStatus @default(READY_TO_SHIP)
  shippedAt           DateTime?
  estimatedDeliveryAt DateTime?

  sellerOrder SellerOrder     @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)
  events      ShipmentEvent[]

  @@index([status, updatedAt])
  @@map("shipments")
}

model OrderStatusHistory {
  id        String       @id @default(cuid())
  orderId   String
  oldStatus OrderStatus?
  newStatus OrderStatus
  changedBy String
  note      String?
  createdAt DateTime     @default(now())

  order         Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  sellerOrderId String?
  sellerOrder   SellerOrder? @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@index([changedBy])
  @@map("order_status_history")
}

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([cartId, variantId])
  @@index([variantId])
  @@map("cart_items")
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([userId, productId])
  @@index([productId])
  @@map("wishlist_items")
}

model Address {
  id            String   @id @default(cuid())
  userId        String
  recipientName String
  phone         String
  addressLine1  String
  addressLine2  String?
  city          String
  state         String
  postalCode    String
  country       String   @default("India")
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isDefault])
  @@map("addresses")
}

enum PaymentStatus {
  CREATED
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUND_PENDING
  REFUNDED
}

enum PaymentMethod {
  ONLINE
  COD
}

// One row per payment attempt. Retries create a new row, so failures are never overwritten.
model Payment {
  id               String        @id @default(cuid())
  orderId          String
  userId           String
  gatewayOrderId   String?       @unique
  gatewayPaymentId String?
  amount           Decimal       @db.Decimal(12, 2)
  currency         String        @default("INR") @db.Char(3)
  status           PaymentStatus @default(CREATED)
  method           PaymentMethod @default(ONLINE)

  authorizedAt   DateTime?
  capturedAt     DateTime?
  failedAt       DateTime?
  failureCode    String?
  failureReason  String?
  lastEventId    String?
  requiresReview Boolean   @default(false)
  reviewReason   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  order          Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user           User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  refunds        PaymentRefund[]
  returnRequests ReturnRequest[]

  @@index([orderId])
  @@index([userId])
  @@index([gatewayPaymentId])
  @@map("payments")
}

model SellerStatusHistory {
  id              String       @id @default(cuid())
  sellerProfileId String
  adminId         String
  fromStatus      SellerStatus
  toStatus        SellerStatus
  reason          String?
  createdAt       DateTime     @default(now())

  sellerProfile SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)
  admin         User          @relation("SellerStatusHistoryAdmin", fields: [adminId], references: [id], onDelete: Restrict)

  @@index([sellerProfileId, createdAt])
  @@index([adminId])
  @@map("seller_status_histories")
}

model ProductStatusHistory {
  id         String        @id @default(cuid())
  productId  String
  adminId    String
  fromStatus ProductStatus
  toStatus   ProductStatus
  reason     String?
  createdAt  DateTime      @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  admin   User    @relation("ProductStatusHistoryAdmin", fields: [adminId], references: [id], onDelete: Restrict)

  @@index([productId, createdAt])
  @@index([adminId])
  @@map("product_status_histories")
}

model CustomerStatusHistory {
  id         String     @id @default(cuid())
  customerId String
  adminId    String
  fromStatus UserStatus
  toStatus   UserStatus
  reason     String?
  createdAt  DateTime   @default(now())

  customer User @relation("CustomerStatusHistoryCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  admin    User @relation("CustomerStatusHistoryAdmin", fields: [adminId], references: [id], onDelete: Restrict)

  @@index([customerId, createdAt])
  @@index([adminId])
  @@map("customer_status_histories")
}

model PaymentRefund {
  id              String   @id @default(cuid())
  paymentId       String
  gatewayRefundId String   @unique
  amount          Decimal  @db.Decimal(12, 2)
  currency        String   @db.Char(3)
  status          String
  lastEventId     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  payment       Payment        @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  returnRequest ReturnRequest?

  @@index([paymentId])
  @@map("payment_refunds")
}

// Webhook idempotency + audit trail.
model WebhookEvent {
  id          String    @id @default(cuid())
  eventId     String    @unique
  provider    String    @default("RAZORPAY")
  eventType   String
  status      String
  outcome     String?
  payload     Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@index([eventType])
  @@map("webhook_events")
}

enum EscalationType {
  AUTO
  CUSTOMER
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  CANCELLED
  ITEM_RECEIVED
  REFUND_INITIATED
  REFUNDED
  REFUND_FAILED
  CLOSED
}

enum ReturnReason {
  DEFECTIVE
  WRONG_ITEM
  NOT_AS_DESCRIBED
  SIZE_ISSUE
  CHANGED_MIND
  OTHER
}

// One return request belongs to one seller order. Items can be partial.
model ReturnRequest {
  id            String       @id @default(cuid())
  returnNumber  String       @unique
  orderId       String
  sellerOrderId String
  userId        String
  status        ReturnStatus @default(REQUESTED)
  reason        ReturnReason
  customerNote  String?
  sellerNote    String?
  adminNote     String?

  refundAmount         Decimal @db.Decimal(12, 2)
  currency             String  @default("INR") @db.Char(3)
  paymentId            String?
  paymentRefundId      String? @unique
  refundIdempotencyKey String? @unique

  carrierName    String?
  trackingNumber String?
  trackingUrl    String?

  receivedAt DateTime?

  escalatedAt      DateTime?
  escalationReason String?
  escalationType   EscalationType?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  order         Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  sellerOrder   SellerOrder           @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)
  user          User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  payment       Payment?              @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  paymentRefund PaymentRefund?        @relation(fields: [paymentRefundId], references: [id], onDelete: Restrict)
  items         ReturnItem[]
  history       ReturnStatusHistory[]

  @@index([userId, createdAt])
  @@index([sellerOrderId, status])
  @@index([orderId])
  @@index([status])
  @@map("return_requests")
}

model ReturnItem {
  id           String  @id @default(cuid())
  returnId     String
  orderItemId  String
  quantity     Int
  unitPrice    Decimal @db.Decimal(12, 2)
  refundAmount Decimal @db.Decimal(12, 2)

  returnRequest ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@unique([returnId, orderItemId])
  @@index([orderItemId])
  @@map("return_items")
}

// Audit trail: every status change with who did it and why.
model ReturnStatusHistory {
  id        String        @id @default(cuid())
  returnId  String
  oldStatus ReturnStatus?
  newStatus ReturnStatus
  changedBy String
  actorRole String
  note      String?
  createdAt DateTime      @default(now())

  returnRequest ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([returnId, createdAt])
  @@map("return_status_history")
}

model ShipmentEvent {
  id              String         @id @default(cuid())
  shipmentId      String
  status          ShipmentStatus
  description     String?
  source          String         @default("SELLER")
  actorId         String?
  providerEventId String?        @unique
  createdAt       DateTime       @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, createdAt])
  @@index([status])
  @@map("shipment_events")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  dedupeKey String           @unique
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}
